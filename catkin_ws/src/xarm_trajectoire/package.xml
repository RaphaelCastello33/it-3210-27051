<?xml version="1.0"?>
<package format="2">
  <name>xarm_trajectoire</name>
  <version>0.0.1</version>
  <description>Trajectoires MoveIt pour xArm6</description>

  <maintainer email="team@enseirb.fr">ENSEIRB Team</maintainer>
  <license>BSD</license>

  <!-- OBLIGATOIRE -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Dépendances de build -->
  <build_depend>roscpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>moveit_core</build_depend>
  <build_depend>moveit_ros_planning</build_depend>
  <build_depend>moveit_ros_planning_interface</build_depend>
  <build_depend>moveit_msgs</build_depend>
  <build_depend>message_generation</build_depend>

  <!-- Dépendances à l'exécution -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_core</exec_depend>
  <exec_depend>moveit_ros_planning</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <!-- Packages nécessaires pour la description + MoveIt xArm6 -->
  <exec_depend>xarm6_moveit_config</exec_depend>
  <exec_depend>xarm_description</exec_depend>

</package>